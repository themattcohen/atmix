# =============================================================================
# FBAR Unified Deployment - Environment Variables
# =============================================================================
# Usage: docker compose -f docker-compose.prod.yml --env-file .env up -d --build
# Copy this file to .env and fill in ALL values before deploying.
# Do NOT commit .env to version control.
# See claudedocs/DEPLOY-HETZNER-UNIFIED.md for full setup guide.
#
# Secret generation commands:
#   openssl rand -base64 32   → for NextAuth secrets and CRON_SECRET
#   openssl rand -hex 32      → for encryption keys (must be 64 hex chars)
#
# IMPORTANT: B2B and D2C MUST have DIFFERENT NEXTAUTH_SECRET and ENCRYPTION_KEY values.
# =============================================================================


# --- Domains ---
# Used by Caddy for automatic TLS certificate provisioning.
B2B_DOMAIN=fbar-preparer.yourdomain.com
D2C_DOMAIN=fbardirect.com


# =============================================================================
# Shared Database (PostgreSQL)
# =============================================================================
# Superuser credentials — used by init-db.sh, pg_dump backups, and manual admin only.
# App containers use dedicated per-database users (see below).
POSTGRES_USER=fbar
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fbar_automator

# --- B2B App Database User (access to fbar_automator ONLY) ---
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_B2B_PASSWORD=CHANGE_ME_B2B
B2B_DATABASE_URL=postgresql://fbar_b2b:CHANGE_ME_B2B@postgres:5432/fbar_automator

# --- D2C App Database User (access to fbar_direct ONLY) ---
# Generate: openssl rand -base64 24 | tr -d '/+=' | head -c 24
POSTGRES_D2C_PASSWORD=CHANGE_ME_D2C
D2C_DATABASE_URL=postgresql://fbar_d2c:CHANGE_ME_D2C@postgres:5432/fbar_direct


# =============================================================================
# Shared S3 / MinIO (Object Storage)
# =============================================================================
# Shared MinIO container — each app uses a separate bucket.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=us-east-1
# B2B bucket for statement uploads
B2B_S3_BUCKET=fbar-statements
# D2C bucket for direct-filing documents
D2C_S3_BUCKET=fbar-direct


# =============================================================================
# Redis (B2B only — used for BullMQ job queue)
# =============================================================================
# Generate: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME
# Must match REDIS_PASSWORD above (duplicated for compose interpolation)
REDIS_URL=redis://:CHANGE_ME@redis:6379


# =============================================================================
# B2B Authentication (NextAuth.js)
# =============================================================================
# Generate: openssl rand -base64 32
# MUST differ from D2C_NEXTAUTH_SECRET
B2B_NEXTAUTH_SECRET=CHANGE_ME
B2B_NEXTAUTH_URL=https://fbar-preparer.yourdomain.com


# =============================================================================
# D2C Authentication (NextAuth.js)
# =============================================================================
# Generate: openssl rand -base64 32
# MUST differ from B2B_NEXTAUTH_SECRET
D2C_NEXTAUTH_SECRET=CHANGE_ME
D2C_NEXTAUTH_URL=https://fbardirect.com


# =============================================================================
# B2B Specific Variables
# =============================================================================

# Anthropic (Claude API) — used for LLM statement extraction
ANTHROPIC_API_KEY=sk-ant-...

# Cron / API route protection
# Generate: openssl rand -base64 32
CRON_SECRET=CHANGE_ME

# Encryption key for sensitive B2B data (TIN, account numbers)
# Generate: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
# MUST differ from D2C_ENCRYPTION_KEY
ENCRYPTION_KEY=CHANGE_ME

# Worker tuning
# Concurrent LLM extraction jobs (default: 10)
WORKER_CONCURRENCY=10
# Max extraction jobs per minute (default: 60)
WORKER_RATE_LIMIT_MAX=60

# Email delivery (Resend) — leave blank to disable email in B2B
RESEND_API_KEY=
B2B_RESEND_FROM_EMAIL=noreply@fbarautomator.com


# =============================================================================
# D2C Specific Variables
# =============================================================================

# Anthropic (Claude API) — used for D2C AI features
D2C_ANTHROPIC_API_KEY=sk-ant-...

# Stripe — use live keys in production, test keys for staging
D2C_STRIPE_SECRET_KEY=sk_live_...
D2C_STRIPE_WEBHOOK_SECRET=whsec_...

# Encryption key for sensitive D2C data (TIN, account numbers)
# Generate: openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes)
# MUST differ from ENCRYPTION_KEY (B2B)
D2C_ENCRYPTION_KEY=CHANGE_ME

# Email delivery (Resend)
D2C_RESEND_API_KEY=re_...
D2C_RESEND_FROM_EMAIL=noreply@fbardirect.com


# =============================================================================
# D2C FinCEN SFTP (BSA E-Filing / SDTM)
# =============================================================================
# Leave SDTM_SANDBOX_MODE=true until you have a live FinCEN SFTP account.
SDTM_HOST=
SDTM_PORT=22
SDTM_USERNAME=
# Path to SSH private key file inside the container (mount via docker volume or secret)
SDTM_PRIVATE_KEY_PATH=
SDTM_REMOTE_DIR=/upload
SDTM_SANDBOX_MODE=true

# --- FinCEN Transmitter (XML batch header) ---
# These identify the transmitting organization in every FBAR XML batch.
# Production TCC: PBSA8180 (issued 2026-02-27)
FINCEN_TRANSMITTER_NAME=All Solutions Consulting
FINCEN_TRANSMITTER_TIN=883761328
FINCEN_TRANSMITTER_TCC=PBSA8180
FINCEN_TRANSMITTER_CONTACT_PHONE=3035555555
FINCEN_TRANSMITTER_CONTACT_NAME=Matthew Cohen
FINCEN_TRANSMITTER_ADDRESS=123 Main St, Denver, CO 80202


# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production, ensure ALL of the following are done:
#
#  1. B2B_NEXTAUTH_SECRET  → openssl rand -base64 32 (unique, not shared with D2C)
#  2. D2C_NEXTAUTH_SECRET  → openssl rand -base64 32 (unique, not shared with B2B)
#  3. ENCRYPTION_KEY       → openssl rand -hex 32 (64 chars, unique to B2B)
#  4. D2C_ENCRYPTION_KEY   → openssl rand -hex 32 (64 chars, unique to D2C)
#  5. POSTGRES_PASSWORD    → strong random password; update both DATABASE_URL values
#  6. S3_ACCESS_KEY / S3_SECRET_KEY → strong random values
#  7. REDIS_PASSWORD       → openssl rand -base64 32; update REDIS_URL to match
#  8. CRON_SECRET          → openssl rand -base64 32
#  9. ANTHROPIC_API_KEY    → real key for B2B LLM extraction
# 10. D2C_ANTHROPIC_API_KEY → real key for D2C AI features
# 11. D2C_STRIPE_SECRET_KEY / D2C_STRIPE_WEBHOOK_SECRET → live Stripe keys
# 12. D2C_RESEND_API_KEY  → real Resend key with verified sender domain
# 13. SDTM_*              → real FinCEN SFTP credentials when ready for live filing
# 14. B2B_DOMAIN / D2C_DOMAIN → real production hostnames (DNS must point to server)
# 15. B2B_NEXTAUTH_URL / D2C_NEXTAUTH_URL → must match domains above with https://
# =============================================================================
