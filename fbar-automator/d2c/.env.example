# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fbar_direct?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3001"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..." # Not currently used; using Stripe Checkout redirect
STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..." # Not currently used; price is hardcoded in stripe.ts

# AWS S3 / MinIO
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="fbar-direct"
# Server-side encryption — requires KMS on MinIO. Set to "AES256" when using AWS S3
# or MinIO with KMS configured. Leave empty to disable.
S3_SERVER_SIDE_ENCRYPTION="AES256"
# S3_PUBLIC_ENDPOINT is used for generating browser-accessible presigned URLs.
# In local dev, leave unset (falls back to S3_ENDPOINT).
# In production with docker-compose, set to the public-facing MinIO/S3 URL.
# S3_PUBLIC_ENDPOINT="https://s3.yourdomain.com"

# Anthropic (AI extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (email)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@fbardirect.com"

# SDTM (FinCEN SFTP)
SDTM_HOST=""
SDTM_PORT="22"
SDTM_USERNAME=""
SDTM_PRIVATE_KEY_PATH=""
SDTM_REMOTE_DIR="/upload"
SDTM_SANDBOX_MODE="true"
# Obtain via: ssh-keyscan sdtm.fincen.gov | base64
SDTM_HOST_KEY=""

# Cron Job Authentication
# Used to authenticate scheduled cron job requests (submit-paid, poll-submitted)
# Generate with: openssl rand -base64 32
CRON_SECRET="change-me-in-production"

# FinCEN Transmitter (XML batch header)
# These identify the transmitting organization in every FBAR XML batch.
# Production TCC: PBSA8180 (issued 2026-02-27)
FINCEN_TRANSMITTER_NAME="All Solutions Consulting"
FINCEN_TRANSMITTER_TIN="883761328"
FINCEN_TRANSMITTER_TCC="PBSA8180"
FINCEN_TRANSMITTER_CONTACT_PHONE="3035555555"
FINCEN_TRANSMITTER_CONTACT_NAME="Matthew Cohen"
FINCEN_TRANSMITTER_ADDRESS="123 Main St, Denver, CO 80202"

# Encryption
# Must be exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_run_openssl_rand_hex_32_to_generate"

# Analytics
NEXT_PUBLIC_GTM_ID=GT-XXXXXXX    # Google Tag ID (GT-xxx) or GA4 Measurement ID (G-xxx)
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXXX  # Google Ads account ID for conversion tracking
NEXT_PUBLIC_GADS_PURCHASE_LABEL=   # Conversion label for Purchase action
NEXT_PUBLIC_GADS_SIGNUP_LABEL=     # Conversion label for Sign-up action
GA4_MEASUREMENT_ID=G-XXXXXXX
GA4_API_SECRET=xxxxx
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile (contact form spam protection)
TURNSTILE_SECRET_KEY=0x...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# Sentry
SENTRY_DSN=https://fca9ffdfda7182d563720b28e2097cb7@o4510765183467520.ingest.us.sentry.io/4510964074020864
NEXT_PUBLIC_SENTRY_DSN=https://fca9ffdfda7182d563720b28e2097cb7@o4510765183467520.ingest.us.sentry.io/4510964074020864
SENTRY_ORG=atmix
SENTRY_PROJECT=fbar-direct

# =============================================================================
# Docker Compose Production (docker-compose.prod.yml)
# =============================================================================
# These are used by docker-compose.prod.yml for service configuration.
# For local development, the values above are sufficient.

# PostgreSQL container
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="fbar_direct"

# MinIO container
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me-in-production"

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production:
# 1. Set NEXTAUTH_SECRET to a strong random value: openssl rand -base64 32
# 2. Set NEXTAUTH_URL to your production URL with https:// (e.g., https://app.fbardirect.com)
# 3. Set ENCRYPTION_KEY to a random 64-char hex string: openssl rand -hex 32
# 4. Set POSTGRES_PASSWORD to a strong random password
# 5. Set MINIO_ROOT_PASSWORD to a strong random password
# 6. Update DATABASE_URL to use production postgres credentials
# 7. Update S3_ENDPOINT to production MinIO/S3 URL (internal network: http://minio:9000)
# 8. Set real Stripe keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
# 9. Set real Resend API key and verified sender domain
# 10. Configure SDTM credentials for FinCEN SFTP submission

# Gemini (blog hero image generation)
GEMINI_API_KEY=
