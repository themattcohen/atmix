# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fbar_direct?schema=public"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3001"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..." # Not currently used; using Stripe Checkout redirect
STRIPE_WEBHOOK_SECRET="whsec_..."
# STRIPE_PRICE_ID="price_..." # Not currently used; price is hardcoded in stripe.ts

# AWS S3 / MinIO
S3_ENDPOINT="http://localhost:9002"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="fbar-direct"
# Server-side encryption — requires KMS on MinIO. Set to "AES256" when using AWS S3
# or MinIO with KMS configured. Leave empty to disable.
S3_SERVER_SIDE_ENCRYPTION="AES256"
# S3_PUBLIC_ENDPOINT is used for generating browser-accessible presigned URLs.
# In local dev, leave unset (falls back to S3_ENDPOINT).
# In production with docker-compose, set to the public-facing MinIO/S3 URL.
# S3_PUBLIC_ENDPOINT="https://s3.yourdomain.com"

# Anthropic (AI extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# Resend (email)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@fbardirect.com"

# SDTM (FinCEN SFTP) — SFTP only, no FTP/FTPS
# Production: bsaefiling-direct-transfer.fincen.gov (164.95.10.142:2222)
# Sandbox:    bsaefiling-direct-transfer-sandbox.fincen.gov (164.95.10.143:2222)
SDTM_HOST="bsaefiling-direct-transfer.fincen.gov"
SDTM_PORT="2222"
SDTM_USERNAME=""
SDTM_PRIVATE_KEY_PATH=""
SDTM_PASSWORD=""
# Per SDTMRequirements.pdf v2.0: upload into submissions/ subfolder
SDTM_REMOTE_DIR="submissions"
# Per SDTMRequirements.pdf v2.0: acks are in acks/ subfolder
SDTM_ACK_DIR="acks"
SDTM_SANDBOX_MODE="true"
# Obtain via: ssh-keyscan -p 2222 bsaefiling-direct-transfer.fincen.gov | base64
SDTM_HOST_KEY=""

# Cron Job Authentication
# Used to authenticate scheduled cron job requests (submit-paid, poll-submitted)
# Generate with: openssl rand -base64 32
CRON_SECRET="change-me-in-production"

# Internal API Secret — protects /api/metrics endpoint
# Generate with: openssl rand -base64 32
INTERNAL_API_SECRET=          # Secret for /api/metrics endpoint

# FinCEN Transmitter (XML batch header)
# These identify the transmitting organization in every FBAR XML batch.
# Production TCC: PBSA8180 (issued 2026-02-27)
FINCEN_TRANSMITTER_NAME="All Solutions Consulting"
FINCEN_TRANSMITTER_TIN="000000000"
FINCEN_TRANSMITTER_TCC="PBSA8180"
FINCEN_TRANSMITTER_CONTACT_PHONE="8888635518"
FINCEN_TRANSMITTER_CONTACT_NAME="Matthew Cohen"
FINCEN_TRANSMITTER_ADDRESS="6732 W Coal Mine Ave Ste 451, Littleton, CO 80123"

# Admin Dashboard
# Used by prisma/seed.ts to create/promote admin user. Leave empty to skip.
ADMIN_EMAIL="admin@fbardirect.com"
ADMIN_PASSWORD=""

# Encryption
# Must be exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY="CHANGE_ME_run_openssl_rand_hex_32_to_generate"

# Analytics
NEXT_PUBLIC_GTM_ID=GT-XXXXXXX    # Google Tag ID (GT-xxx) or GA4 Measurement ID (G-xxx)
NEXT_PUBLIC_GADS_ID=AW-XXXXXXXXXX  # Google Ads account ID for conversion tracking
NEXT_PUBLIC_GADS_PURCHASE_LABEL=   # Conversion label for Purchase action
NEXT_PUBLIC_GADS_SIGNUP_LABEL=     # Conversion label for Sign-up action
# GA4_MEASUREMENT_ID=G-XXXXXXX   # Deprecated — use NEXT_PUBLIC_GTM_ID instead
# GA4_API_SECRET=xxxxx            # Deprecated — use NEXT_PUBLIC_GTM_ID instead
GOOGLE_SITE_VERIFICATION=

# Cloudflare Turnstile (contact form spam protection)
TURNSTILE_SECRET_KEY=0x...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# Sentry
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org
SENTRY_PROJECT=fbar-direct
# Personal auth token (sntryu_...) — for Sentry API access (alerts, releases)
SENTRY_AUTH_TOKEN=sntryu_...
# Org-scoped auth token (sntrys_...) — currently unused (invalid token issued)
# SENTRY_ORG_AUTH_TOKEN=sntrys_...

# =============================================================================
# Docker Compose Production (docker-compose.prod.yml)
# =============================================================================
# These are used by docker-compose.prod.yml for service configuration.
# For local development, the values above are sufficient.

# PostgreSQL container
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="fbar_direct"

# MinIO container
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="change-me-in-production"

# =============================================================================
# Production Checklist
# =============================================================================
# Before deploying to production:
# 1. Set NEXTAUTH_SECRET to a strong random value: openssl rand -base64 32
# 2. Set NEXTAUTH_URL to your production URL with https:// (e.g., https://app.fbardirect.com)
# 3. Set ENCRYPTION_KEY to a random 64-char hex string: openssl rand -hex 32
# 4. Set POSTGRES_PASSWORD to a strong random password
# 5. Set MINIO_ROOT_PASSWORD to a strong random password
# 6. Update DATABASE_URL to use production postgres credentials
# 7. Update S3_ENDPOINT to production MinIO/S3 URL (internal network: http://minio:9000)
# 8. Set real Stripe keys (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
# 9. Set real Resend API key and verified sender domain
# 10. Configure SDTM credentials for FinCEN SFTP submission

# Gemini API — blog hero image generation (fbar-direct project, project number 4450758728)
# Standard Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Serper.dev — SERP data for SEO scorer (required for full scoring)
# Free tier: 2,500 queries/month — https://serper.dev
# Used by: scripts/seo-scorer (keyword coverage + AEO PAA matching)
SERPER_API_KEY=

# DataForSEO — keyword expansion for NLP term extraction
# Free trial available — https://dataforseo.com
# Used by: scripts/seo-scorer extract (corpus expansion for niche keywords)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Google NLP API — entity salience enrichment (optional)
# Free tier: 5,000 units/month — https://cloud.google.com/natural-language
GOOGLE_NLP_API_KEY=

# Google Search Console — GSC feedback loop
# Service account credentials for headless CLI access
# Add service account email to GSC property as Restricted user
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=

# Site URL for GSC page matching
SITE_URL=https://fbardirect.com
GSC_SITE_URL=sc-domain:fbardirect.com
