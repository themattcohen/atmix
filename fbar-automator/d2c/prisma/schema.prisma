generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User IS the filer (no separate Client model)
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  middleName    String?
  suffix        String?
  tin           String?   // Encrypted SSN/ITIN
  tinType       TINType?
  dateOfBirth   DateTime?
  usAddress     Json?     // { street, street2?, city, state, zip }
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tokenVersion        Int       @default(0)
  failedLoginAttempts Int       @default(0)
  lockoutUntil        DateTime?

  accounts      ForeignAccount[]
  filingYears   FilingYear[]
  payments      Payment[]
  resetTokens   PasswordResetToken[]
  statements    Statement[]
}

model ForeignAccount {
  id                String        @id @default(cuid())
  userId            String
  institutionName   String
  institutionAddress Json?        // { street?, city?, country }
  accountNumber     String        // Encrypted
  accountType       AccountType
  ownershipType     OwnershipType
  countryCode       String        // ISO 3166-1 alpha-2
  isJointAccount    Boolean       @default(false)
  jointOwnerInfo    String?
  maxValueLocal     Decimal       @db.Decimal(18, 2)
  maxValueUsd       Decimal?      @db.Decimal(18, 2)
  currencyCode      String        // ISO 4217
  exchangeRate      Decimal?      @db.Decimal(12, 6)
  exchangeRateSource ExchangeRateSource?
  calendarYear      Int
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calendarYear])
}

model FilingYear {
  id                  String       @id @default(cuid())
  userId              String
  calendarYear        Int
  status              FilingStatus @default(NOT_STARTED)
  filingType          FilingType   @default(ORIGINAL)
  has25PlusAccounts   Boolean      @default(false)
  tier                PricingTier  @default(BASIC)

  // Signature
  signedAt            DateTime?
  signatureIp         String?
  signatureData       Json?        // { type: 'typed'|'drawn', value: string }
  form114aUrl         String?

  // Payment
  stripePaymentId     String?
  stripeSessionId     String?

  // SDTM Submission
  sdtmSubmissionId    String?
  sdtmBatchId         String?
  bsaId               String?
  submittedAt         DateTime?
  acknowledgedAt      DateTime?
  rejectionReason     String?

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments            Payment[]

  @@unique([userId, calendarYear, filingType])
  @@index([userId])
}

model Payment {
  id                    String        @id @default(cuid())
  userId                String
  filingYearId          String
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  filingYear            FilingYear    @relation(fields: [filingYearId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([filingYearId])
}

model ExchangeRate {
  id            String              @id @default(cuid())
  currencyCode  String
  countryName   String
  rate          Decimal             @db.Decimal(12, 6)
  recordDate    DateTime
  source        ExchangeRateSource  @default(TREASURY)
  createdAt     DateTime            @default(now())

  @@unique([currencyCode, recordDate, source])
  @@index([currencyCode])
}

enum TINType {
  SSN
  ITIN
}

enum AccountType {
  BANK
  SECURITIES
  OTHER
}

enum OwnershipType {
  FINANCIAL_INTEREST
  SIGNATURE_AUTHORITY
  BOTH
}

enum FilingStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEWED
  SIGNED
  PAID
  SUBMITTING
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum FilingType {
  ORIGINAL
  AMENDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ExchangeRateSource {
  TREASURY
  MANUAL
}

enum PricingTier {
  BASIC
  PREMIUM
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
}

model Statement {
  id                String   @id @default(cuid())
  userId            String
  filingYearId      String
  filePath          String
  fileName          String
  fileType          String
  fileSizeBytes     Int
  extractionStatus  String   @default("PENDING")
  extractionError   String?
  rawExtraction     Json?
  extractedAccounts Json?
  llmModel          String?
  llmTokensUsed     Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([filingYearId])
}
