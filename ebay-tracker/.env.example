# eBay API Credentials (from developer.ebay.com)
EBAY_CLIENT_ID=YourAppId-PRD-xxxxx
EBAY_CLIENT_SECRET=PRD-xxxxx-xxxxx
EBAY_DEV_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EBAY_REDIRECT_URI=YourAppName-PRD-xxxxx-xxxxxxxx
EBAY_REFRESH_TOKEN=v^1.1#i^1#r^1#...

# Environment: 'production' or 'sandbox'
EBAY_ENVIRONMENT=production

# Sync interval in minutes (default: 10)
SYNC_INTERVAL_MINUTES=10

# Server port (default: 3000)
PORT=3000

# SQLite database path (default: ./db/watchlist.db)
DATABASE_PATH=./db/watchlist.db

# Node environment
NODE_ENV=development

# Anthropic API key (optional — enables AI title parsing for card metadata)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Enable batch mode for title parsing (optional, default: false)
ANTHROPIC_BATCH_ENABLED=false
