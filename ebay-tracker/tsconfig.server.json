{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist",
    "declaration": false,
    "jsx": "react-jsx"
  },
  "include": ["src/server.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules", "src/app/**", "src/components/**", "src/hooks/**", "src/store/**"]
}
