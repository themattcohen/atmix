{
  "name": "bluebucket-server",
  "version": "1.0.0",
  "description": "Blue Bucket voice agent webhook server - Retell + Jobber integration",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:unit": "jest tests/handlers.test.js",
    "test:integration": "jest tests/api.test.js",
    "test:outbound": "jest tests/outbound.test.js",
    "test:all": "jest --verbose",
    "docker:build": "docker build -t bluebucket-server .",
    "docker:run": "docker-compose up",
    "docker:dev": "docker-compose up --build"
  },
  "dependencies": {
    "@upstash/redis": "^1.28.0",
    "axios": "^1.6.5",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.12.0",
    "morgan": "^1.10.0",
    "retell-sdk": "^4.66.0",
    "twilio": "^4.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
