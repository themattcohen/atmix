# Someday Consultants - Environment Variables
# Copy to .env and fill in real values

# Linear - Issue tracking and workflow
LINEAR_API_KEY=lin_api_...

# Baserow - Database token for row CRUD operations
BASEROW_API_TOKEN=...
BASEROW_MCP_URL=https://api.baserow.io/mcp/.../sse

# Baserow - User credentials for JWT auth (required for schema changes)
BASEROW_EMAIL=
BASEROW_PASSWORD=

# GHL (GoHighLevel) - Marketing and contacts
GHL_LOCATION_ID=
GHL_API_TOKEN=pit-...

# GHL Web Login (for Playwright automation)
GHL_EMAIL=
GHL_PASSWORD=

# n8n (self-hosted) - Automation workflows
N8N_URL=https://your-n8n-instance.com
N8N_API_KEY=

# Anthropic (Claude API for SaraBot)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Railway (Cloud Deployment)
RAILWAY_PROJECT_ID=
RAILWAY_TOKEN=
