break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n                    \n                    \n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    </div>\n    \n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;border-width:0px;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">Make Them an Offer They Can\u2019t Refuse</span></h2><p><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">Hi Sara,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">When it comes to making offers on a business, you don\u2019t want to come off like a clueless rookie. You want to come in cool, calculated, and compelling.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">So I created a framework to help you do exactly that. And yes, it\u2019s called M.A.F.I.A.\u2014because who understands business negotiation better than the original entrepreneurs in pinstripes?</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Here\u2019s how to make your offer bulletproof (and maybe a little intimidating\u2014in a good way):</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>M \u2013 Market Demand:</strong><br>Is it a buyer\u2019s market or a seller\u2019s market? That shiny accounting firm might look unreasonably expensive in May but be 80% of the cost by December. Timing is everything.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>A \u2013 Adjusted EBITDA:</strong><br>This isn\u2019t just about the profit number in the listing. You need to adjust for reality\u2014like whether you\u2019ll be replacing an owner-operator. Because spoiler: hiring someone who knows what they\u2019re doing is not simple and if you do pull it off, it costs money, and that affects your real returns.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>F \u2013 Financing Realities:</strong><br>Please, I beg you\u2014don\u2019t offer a price you can\u2019t actually fund. You need to know if you\u2019re using SBA, cash, seller finance (rare), or investor capital. Pitching a fantasy offer just wastes everyone\u2019s time. Bonus points if you don\u2019t offer <em>terms</em> the bank won\u2019t allow.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>I \u2013 Industry Multiples:</strong><br>If this is the first time you\u2019re hearing \u201cindustry multiple,\u201d stop reading and go Google it. Every industry has them. Don\u2019t offer based on gross revenue unless you want zero leverage when the actual profit numbers look different in diligence. Tie your offer to EBITDA or SDE and show your work.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">A <strong>\u2013 Asking Price:</strong></span><br>Buyers often obsess over financials but forget the most important number in the deal: the seller\u2019s <em data-start=\"188\" data-end=\"194\">real</em> asking price\u2014which has just as much to do with emotions and legacy as dollars. If your offer doesn\u2019t reflect what the seller actually cares about, don\u2019t be surprised when you lose the deal to someone who simply paid more attention.</p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Follow these steps, and you\u2019ll go from looking like a hopeful buyer to a serious contender.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Ready to learn how the deal game <em>really</em> works?</span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/b821dcde40f?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"> </span><span style=\"color: rgb(17, 85, 204); font-size: 14px; color: rgb(17, 85, 204)\"><u>Check out Deal Academy</u></span></a><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">To offers that don\u2019t get laughed off the table,<br>Sara Sharp<br>Partner, SK&amp;S Law Group<br>Founder, Deal Academy</span></p><p><strong><em>P.S. If you're looking to buy or sell an accounting firm, and want me to keep an eye out for you, </em></strong><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/b9928de083f?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>fill out this form here</em></strong></span></a><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>.</em></strong></span></p></div>\n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><p>For more helpful lessons from Deal Academy, check out our <a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/8a250a444fa?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\">Dealmakers Youtube Channel </span></a>where you'll find Sara's <a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/f230265ab54?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=csIoWCXhXsE&amp;t=15s\" title=\"Weekly Wine Down\"><span style=\"color: rgb(52, 37, 219); font-size: 14px; font-family: arial, helvetica, sans-serif; color: rgb(52, 37, 219)\">Weekly Wine Down,</span></a> where she talks about what she's seen in the industry this week and interviews with M&amp;A Experts and Dealmakers.</p><p>You can check out some recent Dealmakers YouTube videos by clicking the images below.</p></div>\n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"min-width:100%;max-width:100%;width:100%;border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"\">\n              \n        <a href=\"https://link.msgsndr.com/email-tracking/236b008811e?contactId=xoXEjJhxZU4nfwkScSXn\" target=\"_blank\">\n          \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/6829cedc6a341002ce74cb8e.webp\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;min-width:100%;width:100%;max-width:100%;font-size:13px;\" width=\"520\">\n    \n        </a>\n      \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\