ter;\">\n        \n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img alt=\"\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\" height=\"auto\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 18pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 22px; color: rgb(0, 0, 0)\"><strong>The Stages of a Deal: A Step-by-Step Guide</strong></span></h2><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>From Sara Sharp: Navigating the Process of Buying an Accounting Firm</strong></span></p><p></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Hi Everyone,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">I\u2019m Sara Sharp, and I help people buy and sell accounting firms.&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Buying a firm can seem like a daunting process, but if you break it down into clear steps, it\u2019s much easier to manage. Here\u2019s a simple guide to help you understand each stage of the deal-making process.</span></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>1. Determining Your Deal Box</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Before you start looking for a firm to buy, you need to define your \u201cdeal box.\u201d This means figuring out what kind of firm you\u2019re looking for. Consider the size, location, client base, and services offered. Knowing exactly what you want will help you focus your search.</span></p><ol style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px;\"><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Location</span></p></li><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Asking Price</span></p></li><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Types of Clients</span></p></li><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Services Offered</span></p></li><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Firm Size by Revenue or Employee Count</span></p></li><li style=\"list-style-type: decimal; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Sellers Discretionary Earnings aka Cashflow</span></p></li></ol><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>2. Searching Online Marketplaces</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Once you know what you\u2019re looking for, start searching online marketplaces. There are many websites that specialize in listing accounting practices for sale. You can filter the search results to match your deal box criteria, ie List Price, Revenue, Cashflow, Location, etc.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Examples:</span></p><ul style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px;\"><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/d432ebc7143?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">BizBuySell.com</span></a></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/461a1e4332a?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Accountingpracticeexchange.com</span></a></p></li></ul><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>3. Submitting an NDA, Personal Financial Statement, and Resume</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">When you find a firm that fits, the next step is to submit a Non-Disclosure Agreement (NDA). The NDA ensures that all information shared between you and the seller remains confidential. Pair the NDA with a Personal Financial Statement (PFS). The Personal Financial Statement shows the seller that you have the financial ability to buy the firm. It may include proof of funds or an SBA Pre-Qualification letter. Attach your resume. This outlines your experience and qualifications to show the seller you're prepared to run the firm.</span></p><p><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/0403c637291?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">SBA Personal Financial Statement</span></a></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>4. Seller Meeting</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If the seller is interested in moving forward, you\u2019ll have a meeting to discuss the firm in more detail. First impressions are EVERYTHING. So take great care with this call.&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">This is your chance to ask questions, learn more about the business, and see if it\u2019s a good fit for you. But most importantly, remember this firm is their baby. Don\u2019t call their baby ugly the first time you meet. It\u2019s an opportunity to build rapport with the seller, which will be essential as you move forward.</span></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>5. Submitting an LOI (Letter of Intent)</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">After the seller meeting, if you decide you want to buy the firm, you\u2019ll submit a Letter of Intent (LOI). The LOI outlines the basic terms of the deal, such as the purchase price, payment terms, and any conditions that need to be met. It\u2019s not legally binding, but it shows the seller that you\u2019re serious about moving forward.</span></p><p><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/93f30705967?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Become an LOI Expert here</span></a></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>6. Due Diligence</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Once the LOI is signed, the due diligence process begins. This is where you carefully review all aspects of the business. This includes financial statements, client contracts, and operations. Due diligence helps you confirm that the business is as it was represented and identify any potential risks.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Sample Due Diligence Document Request List:</span></p><ul style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px;\"><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Last 3 years Income Statements</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Last 3 years Tax Returns</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Current Balance Sheet</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">AR Aging Summary</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Bank Statements</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">General Ledger</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Employee List</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Vendor List</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Client List</span></p></li><li style=\"list-style-type: disc; font-size: 14px; color: rgb(0, 0, 0); background-color: transparent; font-weight: 400; font-style: normal; font-variant: normal; text-decoration: none; vertical-align: baseline;; color: rgb(0, 0, 0); color: rgb(0, 0, 0)\"><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Contracts</span></p></li></ul><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Consider hiring a CPA who specializes in due diligence to perform a Quality of Earnings assessment.&nbsp;</span></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>7. Securing Funding</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">While in due diligence, you\u2019ll want to start the process to secure funding for the deal. This could involve getting a loan from a bank, finding investors, or using your own savings. It\u2019s important to have your financing in place before you move on to the final steps.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If you plan to apply for an SBA 7(a) loan, make sure you\u2019re working with an SBA Preferred Lender. That can save you months in processing time!</span></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>8. Closing the Deal</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">After securing funding, you\u2019re ready to close the deal. This is where all the final paperwork is signed, and the business officially changes hands. Closing the deal usually involves working with attorneys to ensure everything is done correctly.</span></p><h3 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 17px; color: rgb(0, 0, 0)\"><strong>9. Transitioning Ownership</strong></span></h3><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Finally, after the deal closes, you\u2019ll need to transition ownership. This includes training from the previous owner. Introducing yourself to clients and employees. Making necessary changes to the business operations. A smooth transition is key to maintaining the firm\u2019s success and keeping clients and staff happy.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Buying an accounting firm isn't easy. But follow these stages, and you can navigate the process with confidence. Remember, each step is important. Take your time to get things right. It will pay off in the long run.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If you ever have any questions or need guidance, I\u2019m here to help you through each stage of the deal.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">I hope this guide helps you feel more prepared for your next big move.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Best,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Sara Sharp</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Deal Attorney, Partner</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">SK&amp;S Law Group</span></p><p style=\"line-height: 1.25\">--</p><p style=\"line-height: 1.25\">For more helpful lessons from Deal academy, check out our Dealmakers Youtube Channel where you'll find Sara's <a target=\"_blank\" title=\"Weekly Wine Down\" href=\"https://link.msgsndr.com/email-tracking/b69dee9f1a9?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=csIoWCXhXsE&amp;t=15s\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif; color: rgb(0, 0, 0)\">Weekly Wine Down</span></a> where she talks about what she's seen in the industry this week and interviews with M&amp;A Experts and Dealmakers.</p><p style=\"line-height: 1.25\">You can check out our latest Dealmakers podcast episodes by clicking the images below.</p></div>\n    \n        