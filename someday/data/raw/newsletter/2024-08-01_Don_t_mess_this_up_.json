er;\">\n        \n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n        <tbody>\n          \n              <tr>\n                <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                  \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img alt=\"\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\" height=\"auto\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                </td>\n              </tr>\n            \n        </tbody>\n      </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n        <tbody>\n          \n              <tr>\n                <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                  \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                </td>\n              </tr>\n            \n              <tr>\n                <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                  \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"line-height: 1.25;text-align: left;\"><strong>Watch a Lawyer Change Her Mind!</strong></h2><p>Hi Everyone,</p><p>I\u2019m Sara Sharp, and I help people buy and sell accounting firms. After years of helping people with these deals, I've actually learned a new angle on one of the oldest terms out there: <u>exclusivity</u>. </p><p><strong>My Old Way of Thinking: Exclusivity isn't Enforceable So Who Cares</strong></p><p>Historically I've noticed people don't even try to enforce an exclusivity provision because the dollar amount of damages is too low to justify hiring lawyer to fight it out (at least in these sub $5M deals).</p><p><strong>The New Thought: Exclusivity is Can Be Pretty Powerful</strong></p><p>You've heard me talk about the narrow sales window in these deals-spoiler it's SHORT. Basically a couple of months in the summer between tax seasons. By being exclusive for a short period of time, you can motivate people to push through diligence as fast as possible. </p><p><strong>What if You Combine it With a Good Faith Deposit?</strong></p><p>Imagine you're a seller and you stop hearing from your buyer very often. Maybe they've lost the enthusiasm for the deal or they have a few under LOI and they're waiting to see how to allocate capital before they decide which deals to actually go through. What motivation do they have to cut you loose? </p><p><strong>Using Deposit + Exclusivity to = Efficiency</strong></p><p>As you know, I hammer the drum of efficiency in small business deals. You're running a business, you don't have time to waste. Plus the only person who wins in an efficient deal process is the lawyer (tongue firmly in cheek). </p><p><strong>The Point of the Good Faith Deposit</strong></p><p>Let's say the buyer submits a $15,000 good faith deposit tied to the seller agreeing to be exclusive for 60 days. </p><p><strong>So...</strong></p><p>As the deal is waning in day 30, you suddenly have a motivation to let the other side know you're calling it so you can get your money back. Even more nuanced, the buyer has the sudden and significant motivation to admit it to themselves. This serves efficiency and frees both parties up to pursue a deal that'll actually close. GASP. So let me know, did I change your mind about the usefulness of these terms? Even just a little bit?</p><p>Thank you for being part of this journey. Have a wonderful weekend, and don\u2019t forget to enjoy the little things.</p><p>Best,</p><p>Sara Sharp </p><p>Deal Attorney</p><p>Partner, SK&amp;S Law Group</p><p><strong>P.S.</strong> If you have any questions about your next acquisition or sale, feel free to reach out for a consult call. I\u2019m here to help you make your next deal a great one.</p><p style=\"line-height: 1.25\">--</p><p style=\"line-height: 1.25\">For more helpful lessons from Deal academy, check out our Dealmakers Youtube Channel where you'll find Sara's <a target=\"_blank\" title=\"Weekly Wine Down\" href=\"https://link.msgsndr.com/email-tracking/1d21a020c05?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=csIoWCXhXsE&amp;t=15s\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif; color: rgb(0, 0, 0)\">Weekly Wine Down</span></a> where she talks about what she's seen in the industry this week and interviews with M&amp;A Experts and Dealmakers.</p><p style=\"line-height: 1.25\">You can check out our latest Dealmakers podcast episodes by clicking the images below.</p></div>\n    \n                </td>\n              </tr>\n            \n              <tr>\n                <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                  \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:520px;\">\n              \n        <a href=\"https://link.msgsndr.com/email-tracking/288079fbe21?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=C4xeNNDSZO0&amp;t=231s\" target=\"_blank\">\n          \n      <img alt=\"\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/66aa5889e33315551da01337.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"520\" height=\"auto\">\n    \n        </a>\n      \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                </td>\n              </tr>\n            \n              <tr>\n