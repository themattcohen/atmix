e=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 18pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); font-size: 22px; color: rgb(0, 0, 0)\"><strong>Is Your Non-Compete Worthless? Here's How to Fix It</strong></span></h2><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Hi Sara,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Let\u2019s talk about non-competes\u2014a favorite topic for business owners, and one of the most misunderstood legal documents in existence.&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">I see it all the time: non-competes that sound airtight but, when tested, are about as useful as a screen door on a submarine.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>The Big Mistake Everyone\u2019s Making</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">The question everyone asks is \u2018is this even enforceable\u2019? And the answer is usually at least partially yes. But the question people SHOULD be asking is \u2018does this even help me\u2019 and the answer to that is often \u2018nope, not a bit.\u2019</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Most non-competes include a geographical restriction. They say something like:<br><em>\u201cYou can\u2019t compete within 20 miles of this business location.\u201d</em></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">That might have worked when businesses were local, and horse-drawn carriages were all the rage. But in 2024, when services are offered nationwide (hello, internet!), a 20-mile radius is laughably ineffective.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Why It Matters</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If your clients are scattered across the country, what good is a non-compete that only covers a tiny local area? It\u2019s a loophole big enough to drive a semi-truck through. And trust me, if a former employee or buyer wants to compete with you, they <em>will</em> drive through it.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>How to Fix It</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Your non-compete needs to reflect where <u>your clients</u> actually are. If your business operates nationwide, then your non-compete should restrict competitors from providing services to your client base, wherever they\u2019re located. Of course, you do have to balance that against federal and state laws relating to enforceability which is where all the nuance comes in and is why lawyers still have a job.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Don\u2019t Let Your Non-Compete Work Against You</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Non-competes are meant to protect your business, not give you a false sense of security. If your current agreement isn\u2019t built for the way your business operates today, it\u2019s time for a rewrite.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Have questions about making your non-compete actually enforceable? </strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Check </span><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/f166bfcca23?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: #3425db !important; font-size: 14px; color: #3425db !important\">out a recent episode of DealMakers Podcast</span></a><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"> where we discuss non-competes.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">To stronger (and smarter) agreements,<br>Sara Sharp</span><br><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Deal Attorney, Partner</span><br><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">SK&amp;S Law Group</span><br><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Business Consultant and Founder of Deal Academy</span></p><p style=\"line-height: 1.25\">--</p><p style=\"line-height: 1.25\">For more helpful lessons from Deal Academy, check out our <a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/073e3b998c1?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\">Dealmakers Youtube Channel </span></a>where you'll find Sara's <a target=\"_blank\" title=\"Weekly Wine Down\" href=\"https://link.msgsndr.com/email-tracking/ab7a5c4248c?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=csIoWCXhXsE&amp;t=15s\"><span style=\"color: rgb(52, 37, 219); font-size: 14px; font-family: arial, helvetica, sans-serif; color: rgb(52, 37, 219)\">Weekly Wine Down,</span></a> where she talks about what she's seen in the industry this week and interviews with M&amp;A Experts and Dealmakers.</p><p style=\"line-height: 1.25\">You can check out some recent Dealmakers podcast episodes by clicking the images below.</p></div>\n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"min-width:100%;max-width:100%;width:100%;border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"\">\n              \n        <a href=\"https://link.msgsndr.com/email-tracking/2f330ba8a9b?contactId=xoXEjJhxZU4nfwkScSXn\" target=\"_blank\">\n          \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/67618d8363c0febb92d4ed85.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;min-width:100%;width:100%;max-width:100%;font-size:13px;\" width=\"520\">\n    \n        </a>\n      \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"min-width:100%;max-width:100%;width:100%;border-collapse:co