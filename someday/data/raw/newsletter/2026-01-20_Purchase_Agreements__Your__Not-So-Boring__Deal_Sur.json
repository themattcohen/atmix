0px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;border-width:0px;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\" countdown-timer-hide-for-apple-mail=\"false\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n                    \n                    \n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    </div>\n    \n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;border-width:0px;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 18px\">Purchase Agreements: Your (Not-So-Boring) Deal Survival Guide</span></h2><p><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px\">Hi </span>Sara,</p><p><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">If you're buying an accounting firm, you\u2019re going to meet a purchase agreement.&nbsp;</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">And by \u201cmeet,\u201d I mean it\u2019s going to sit on your desk like a 40-page foreign language exam.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">Let\u2019s change that.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">Purchase agreements can look intimidating, but under all that legal lingo, there\u2019s a pattern. A structure. Dare I say... a method to the madness. And understanding it can save you from signing something that quietly sets your hair on fire.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">Here\u2019s the cheat sheet I share with clients:</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Article 1: What You\u2019re Actually Buying<br></strong>Assets, price, terms. It's all in here. Read it like your career depends on it (because it might). Bonus tip: Make sure you understand what's <em>excluded</em>, not just what you're getting. Because if it\u2019s not listed clearly, you\u2019re probably not getting it.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Article 3: The Great List of Promises<br></strong>These are the seller\u2019s (and your) reps and warranties. Think of this as the \u201care you telling the truth and nothing but the truth?\u201d section. The hidden magic? These reps force sellers to disclose things they \u201cforgot\u201d to mention\u2014like pending lawsuits or unpaid wage claims. That\u2019s not just legal housekeeping. That\u2019s gold.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Article 5: Covenants, aka The Thou Shalt Nots<br></strong>This is where the non-competes, non-solicits, and general behavior clauses live. Are they enforceable? Reasonable? Clear enough that you won\u2019t accidentally trip over them just by breathing in the wrong ZIP code? Let\u2019s hope so.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Article 6: Indemnification<br></strong>Also known as \u201cwho\u2019s cleaning up the mess if something goes wrong?\u201d This section matters a lot more than people think, especially when a third party crashes the party with a lawsuit.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Miscellaneous: The Sneaky Stuff<br></strong>Boilerplate doesn\u2019t mean unimportant. I\u2019ve found all kinds of landmines hiding in those standard-seeming sections. Read them. All of them. Yes, even the severability clause.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\"><strong>Signature Lines: Who\u2019s Actually on the Hook<br></strong>Make sure individuals are signing, not just LLCs. You can\u2019t hold \u201cABC Accounting, LLC\u201d accountable when it vanishes six months after closing. You want Jim Anderson\u2019s signature if Jim Anderson is the one making promises.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">Still awake? Then you, my friend, are the exact kind of person I want reading these emails.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">If this made the fog of legalese lift even a little, and you're thinking \u201cHey, maybe I <em>don\u2019t</em> need to go to law school after all,\u201d you\u2019re welcome.&nbsp;</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); color: rgb(0, 0, 0); font-size: 14px; font-family: arial, helvetica, sans-serif\">But if you want to dig even deeper without the student debt, check out</span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/c2540621149?contactId=xoXEjJhxZU4nfwkScSXn&amp;utm_source=email&amp;utm_medium=email marketing\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0); c