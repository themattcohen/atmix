t;background-size:cover;background-position:center center;\">\n        \n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n                    \n                    \n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    </div>\n    \n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;border-width:0px;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">The #1 Reason Your LOIs Keep Getting Rejected </span></h2><p><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">Hi Sara,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Let\u2019s talk about the last \u201cA\u201d in my M.A.F.I.A. framework: Asking Price.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">No, this isn\u2019t just the number on the listing. This is about understanding what the <em>seller</em> actually wants\u2014and if you skip this step, your offer might go straight in the trash.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">I see this mistake constantly. A buyer does all the right things\u2014market research, adjusted EBITDA, checks financing, studies industry multiples\u2014and then they drop a number without ever asking...</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">\u201cWhat does the seller actually care about?\u201d</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Here are some things to consider:</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Is the seller trying to lease you the building they own?<br>Do they want to make sure their team stays employed?<br>Are they emotionally attached to their client base?</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">These things matter <em>a lot</em>. And if your LOI doesn\u2019t speak to them, you\u2019ll lose to someone whose offer is lower but smarter.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Here\u2019s how to fix it:</span></p><ul style=\"margin-top: 0;margin-bottom: 0;padding-inline-start: 48px;\"><li style=\"list-style-type: disc;font-size: 14px;color: rgb(0, 0, 0);background-color: transparent;font-weight: 400;font-style: normal;font-variant: normal;text-decoration: none;vertical-align: baseline;\" dir=\"ltr\" aria-level=\"1\"><p style=\"margin-top: 12pt;margin-bottom: 0pt;\" dir=\"ltr\" role=\"presentation\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Use the seller\u2019s language in your LOI.</span></p></li><li style=\"list-style-type: disc;font-size: 14px;color: rgb(0, 0, 0);background-color: transparent;font-weight: 400;font-style: normal;font-variant: normal;text-decoration: none;vertical-align: baseline;\" dir=\"ltr\" aria-level=\"1\"><p style=\"margin-top: 0pt;margin-bottom: 0pt;\" dir=\"ltr\" role=\"presentation\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Reference things they mentioned in emails or calls.</span></p></li><li style=\"list-style-type: disc;font-size: 14px;color: rgb(0, 0, 0);background-color: transparent;font-weight: 400;font-style: normal;font-variant: normal;text-decoration: none;vertical-align: baseline;\" dir=\"ltr\" aria-level=\"1\"><p style=\"margin-top: 0pt;margin-bottom: 12pt;\" dir=\"ltr\" role=\"presentation\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Show them you listened\u2014and that your offer reflects their goals, not just your spreadsheet.</span></p></li></ul><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">It\u2019s not about caving to every demand. It\u2019s about being strategic with your positioning and human in your approach. Sellers want to feel like their legacy isn\u2019t going to be bulldozed.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">So next time you draft that LOI, think less like a banker and more like a partner. </span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Address their \u201cask\u201d in every sense of the word.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Need help writing a letter of intent that actually gets accepted?</span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/55e8af8dc50?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(17, 85, 204); font-size: 14px; color: rgb(17, 85, 204)\"><u> Deal Academy has a whole course on it.</u></span></a></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">To LOIs that get a second look,<br>Sara Sharp<strong><br></strong>Partner, SK&amp;S Law Group<br>Founder, Deal Academy</span><br><br><strong><em>P.S. If you're looking to buy or sell an accounting firm, and want me to keep an eye out for you, </em></strong><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/d3ea3fe08ef?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>fill out this form here</em></strong></span></a><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>.</em></strong></span></p></div>\n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padd