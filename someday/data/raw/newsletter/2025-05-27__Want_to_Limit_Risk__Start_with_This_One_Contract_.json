ound-position:center center;\">\n        \n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n                    \n                    \n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    </div>\n    \n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n     \n    <div style=\"overflow:hidden;\">\n      <div style=\"background:#ffffff;background-color:#ffffff;border-width:0px;margin:0px auto 0px auto;border-color:transparent;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;border-color:transparent;direction:ltr;font-size:0px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            \n                      \n                    <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n                    <tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">Want to Limit Risk? Start with This One Contract Clause.</span></h2><p><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">Hi Sara,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Let\u2019s talk about timelines. Specifically, how long your reps and warranties should stick around after your business deal closes.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If you\u2019re selling, you probably don\u2019t want a buyer showing up three years later saying, \u201cSurprise! You owe me money for that thing I just discovered.\u201d</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If you\u2019re buying, you absolutely <em>want</em> that runway\u2014because you won\u2019t know everything about the business until you\u2019ve lived through a full annual cycle (or two).</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Enter: the survival clause.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">This clause limits how long certain representations and warranties survive after closing. In other words, it\u2019s a contractual expiration date on how long you can be sued for stuff you promised.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Sellers want shorter. Buyers want longer. Welcome to the eternal tug-of-war that is deal negotiation.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">What\u2019s typical? I\u2019ve seen 12 months, 18 months, 24, even 36. Personally, I like 18 months for buyers\u2014it gives you a year to uncover issues, plus a little breathing room to hire a lawyer and actually <em>do</em> something about it.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Sellers? You\u2019re gunning for 12. Anything longer gives the buyer time to discover problems <em>and</em> get their legal ducks in a row.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Also\u2014let\u2019s not forget about the statute of limitations. Just because the contract doesn\u2019t say how long reps survive doesn\u2019t mean there\u2019s no limit. But it does mean that limit could be a looooong time.</span></p><p style=\"margin-top: 12pt;margin-bottom: 12pt;\" dir=\"ltr\"><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">And unless you\u2019re trying to fund your lawyer\u2019s next vacation home, I recommend putting something in writing.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">To smarter timelines and fewer lawsuits,<br>Sara Sharp<br>Partner, SK&amp;S Law Group<br>Founder, Deal Academy</span><br><br><strong><em>P.S. If you're looking to buy or sell an accounting firm, and want me to keep an eye out for you, </em></strong><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://link.msgsndr.com/email-tracking/bbe8a054c2e?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>fill out this form here</em></strong></span></a><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\"><strong><em>.</em></strong></span></p></div>\n    \n                    </td>\n                  </tr>\n                    \n                    \n                      \n