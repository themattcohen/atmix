e=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"width:400px;\">\n              \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/667c7b5ab458d55a15346991.jpeg\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;width:100%;font-size:13px;\" width=\"400\">\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr>\n          </tbody>\n\n        </table>\n    \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n      </div>\n    \n          <!--[if mso | IE]></td></tr></table><![endif]-->\n              </td>\n            </tr>\n          </tbody>\n        </table>\n        \n      </div>\n    \n      \n      <!--[if mso | IE]></td></tr></table><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"\" role=\"presentation\" style=\"width:600px;\" width=\"600\" bgcolor=\"#ffffff\" ><tr><td style=\"line-height:0px;font-size:0px;mso-line-height-rule:exactly;\"><![endif]-->\n    \n      \n      <div style=\"background:#ffffff;background-color:#ffffff;margin:0px auto;border-radius:0px;max-width:600px;\">\n        \n        <table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"background:#ffffff;background-color:#ffffff;width:100%;border-radius:0px;\">\n          <tbody>\n            <tr>\n              <td style=\"direction:ltr;font-size:0px;padding:20px 0;padding-bottom:10px;padding-left:20px;padding-right:20px;padding-top:10px;text-align:center;\">\n                <!--[if mso | IE]><table role=\"presentation\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\"><tr><td class=\"\" style=\"vertical-align:top;width:560px;\" ><![endif]-->\n            \n      <div class=\"mj-column-per-100 mj-outlook-group-fix\" style=\"font-size:0px;text-align:left;direction:ltr;display:inline-block;vertical-align:top;width:100%;\">\n        \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" width=\"100%\">\n        <tbody>\n          <tr>\n            <td style=\"vertical-align:top;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;\">\n              \n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"\" width=\"100%\">\n          <tbody>\n            <tr>\n                    <td align=\"center\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <p style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:100%;\">\n      </p>\n      \n      <!--[if mso | IE]><table align=\"center\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"border-top:solid 2px rgba(242, 247, 250, 1);font-size:1px;margin:0px auto;width:520px;\" role=\"presentation\" width=\"520px\" ><tr><td style=\"height:0;line-height:0;\"> &nbsp;\n</td></tr></table><![endif]-->\n    \n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"left\" style=\"font-size:0px;padding:10px 25px;padding-top:12px;padding-right:24px;padding-bottom:12px;padding-left:24px;word-break:break-word;\">\n                      \n      <div style=\"font-family:arial, helvetica, sans-serif;font-size:14px;line-height:1.25;text-align:left;color:#000000;\"><h2 style=\"margin-top: 14pt;margin-bottom: 4pt;\"><span style=\"color: rgb(0, 0, 0); color: rgb(0, 0, 0)\">What You Need to Know About Accounting Practice Deals - From the Trenches!</span></h2><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Hi Sara,</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">The accounting industry is evolving at lightning speed, that\u2019s not a surprise to anyone who has a pulse.&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Private equity, valuation inflation, rising interest rates\u2014these trends are reshaping the way accounting firms are built, run, and bought.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">I recently was honored to be invited to join Marcus Dillon, CPA, and Rachel Dillon on their podcast <em>Who\u2019s Really the Boss?</em> to unpack the biggest shifts happening in accounting firm ownership.&nbsp;</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">If you\u2019re in the industry\u2014or just curious about how these changes could ripple into other businesses\u2014you\u2019ll want to tune in.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Here are some highlights from our conversation:</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Phantom Equity Plans Are Everywhere</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Traditional partnerships? Not always the answer. Phantom equity plans are gaining ground, allowing firms to align team incentives without handing over direct ownership. It\u2019s a win-win for firms and employees alike.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Remote Teams, Real Compliance Challenges</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Remote work is the new normal, but compliance hasn\u2019t caught up. From payroll laws to data security, accounting firm owners are navigating murky waters. We break down the common pitfalls and how to avoid them.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>New Buyers Are Entering the Game and Changing the Rules</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">It\u2019s not just CPAs buying firms anymore. Private equity and other non-traditional buyers are changing the playing field, and they\u2019re bringing big opportunities\u2014and challenges\u2014with them.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\"><strong>Millennial Owners Are Shifting Priorities&nbsp;</strong></span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Younger owners are rethinking what success looks like. Work-life balance, profitability, and sustainable growth are at the forefront, and it\u2019s influencing how deals are structured.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">The big takeaway? The accounting industry is no longer \u201cbusiness as usual.\u201d Owners, buyers, and teams are rewriting the rules.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">\ud83c\udfa7</span><span style=\"color: #3425db !important; font-size: 14px; color: #3425db !important\"> [</span><a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/e1f1062ceb1?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: #3425db !important; font-size: 14px; color: #3425db !important\">Listen to the episode here</span></a><span style=\"color: #3425db !important; font-size: 14px; color: #3425db !important\">]</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">As someone who works in the trenches of mergers, acquisitions, and compliance, I love seeing how these shifts are creating opportunities for firms to grow, innovate, and thrive.</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">What am I missing? I\u2019d love to hear your thoughts\u2014just hit reply!</span></p><p><span style=\"color: rgb(0, 0, 0); font-size: 14px; color: rgb(0, 0, 0)\">Here\u2019s to staying ahead of the curve,<br><strong>Sara Sharp<br></strong>Partner, SK&amp;S Law Group<br>Business Consultant and Founder of Deal Academy</span></p><p style=\"line-height: 1.25\">--</p><p style=\"line-height: 1.25\">For more helpful lessons from Deal Academy, check out our <a target=\"_blank\" href=\"https://link.msgsndr.com/email-tracking/bb84ebfbf5d?contactId=xoXEjJhxZU4nfwkScSXn\"><span style=\"color: rgb(52, 37, 219); color: rgb(52, 37, 219)\">Dealmakers Youtube Channel </span></a>where you'll find Sara's <a target=\"_blank\" title=\"Weekly Wine Down\" href=\"https://link.msgsndr.com/email-tracking/d8f84fe1e4e?contactId=xoXEjJhxZU4nfwkScSXn&amp;v=csIoWCXhXsE&amp;t=15s\"><span style=\"color: rgb(52, 37, 219); font-size: 14px; font-family: arial, helvetica, sans-serif; color: rgb(52, 37, 219)\">Weekly Wine Down,</span></a> where she talks about what she's seen in the industry this week and interviews with M&amp;A Experts and Dealmakers.</p><p style=\"line-height: 1.25\">You can check out some recent Dealmakers podcast episodes by clicking the images below.</p></div>\n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n                      \n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"min-width:100%;max-width:100%;width:100%;border-collapse:collapse;border-spacing:0px;\">\n        <tbody>\n          <tr>\n            <td style=\"\">\n              \n        <a href=\"https://link.msgsndr.com/email-tracking/f7276154bf4?contactId=xoXEjJhxZU4nfwkScSXn\" target=\"_blank\">\n          \n      <img height=\"auto\" src=\"https://storage.googleapis.com/msgsndr/oKvxmpgImkZb3TwM9ii4/media/678a5ca3671b4d7d83ecdb45.webp\" style=\"border:0;display:block;outline:none;text-decoration:none;height:auto;min-width:100%;width:100%;max-width:100%;font-size:13px;\" width=\"520\">\n    \n        </a>\n      \n            </td>\n          </tr>\n        </tbody>\n      </table>\n    \n                    </td>\n                  </tr><tr>\n                    <td align=\"full\" style=\"font-size:0px;padding:10px 25px;padding-top:10px;padding-right:20px;padding-bottom:10px;padding-left:20px;word-break:break-word;\">\n         