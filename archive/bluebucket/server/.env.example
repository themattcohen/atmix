# ===========================================
# Blue Bucket Server - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Server
PORT=3000
NODE_ENV=development

# Timezone (for availability calculation)
BUSINESS_TZ=America/Denver

# ===========================================
# Jobber OAuth (from Jobber Developer Portal)
# ===========================================
JOBBER_CLIENT_ID=your_client_id_here
JOBBER_CLIENT_SECRET=your_client_secret_here
JOBBER_REDIRECT_URI=http://localhost:3000/oauth/callback

# Jobber API
JOBBER_API_URL=https://api.getjobber.com/api/graphql

# ===========================================
# Upstash Redis (from Upstash Console)
# ===========================================
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ===========================================
# Retell Webhook Security
# ===========================================
# Generate a random secret: openssl rand -hex 32
# Configure this same value in Retell Dashboard
RETELL_WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# Business Configuration
# ===========================================
# CEO phone for transfers (E.164 format)
CEO_PHONE=+13035551234

# Team capacity (number of cleaning teams)
TEAM_CAPACITY=2

# Business hours (24-hour format)
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
